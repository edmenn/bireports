APP_NAME=Birentable
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
ASSET_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=info

# === BD: Postgres del docker-compose ===
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=birentabledb
DB_USERNAME=birentable
DB_PASSWORD=change-me

# Sesión / Cache / Cola en BD
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=laravel_

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@sarcom.com.py
MAIL_FROM_NAME="${APP_NAME}"

WWWUSER=1000
WWWGROUP=1000

APP_TIMEZONE=America/Asuncion
AUTH_ALLOW_LOCAL_LOGIN=true
POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default

# Detrás de proxy (Caddy/Nginx)
TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOSTS=localhost,127.0.0.1
